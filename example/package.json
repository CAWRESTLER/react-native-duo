{
  "name": "@cawrestler/react-native-duo-example",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@cawrestler/react-native-duo": "workspace:*",
    "@expo/metro-runtime": "~58.0.7",
    "@expo/ui": "~58.0.7",
    "@react-native-community/slider": "5.2.1",
    "expo": "~58.0.0-preview.7",
    "expo-build-properties": "~58.0.7",
    "expo-camera": "~58.0.3",
    "expo-constants": "~58.0.7",
    "expo-dev-client": "~58.0.7",
    "expo-device": "~58.0.2",
    "expo-font": "~58.0.2",
    "expo-glass-effect": "~58.0.2",
    "expo-image": "~58.0.6",
    "expo-linking": "~58.0.7",
    "expo-router": "~58.0.8",
    "expo-splash-screen": "~58.0.1",
    "expo-status-bar": "~58.0.1",
    "expo-symbols": "~58.0.2",
    "expo-system-ui": "~58.0.2",
    "expo-web-browser": "~58.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.1",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:ios": "xcodebuild ONLY_ACTIVE_ARCH=YES -workspace ios/ReactNativeDuoLab.xcworkspace -UseNewBuildSystem=YES -scheme ReactNativeDuoLab -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build -quiet",
    "build:android": "cd android && ./gradlew assembleDebug -DtestBuildType=debug -Dorg.gradle.jvmargs=-Xmx4g",
    "build:web": "expo export --platform web",
    "e2e": "maestro test .maestro",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --no-cache"
  },
  "private": true,
  "devDependencies": {
    "@react-native/metro-config": "0.88.0-rc.1",
    "@types/babel__core": "^7",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "react-native-builder-bob": "^0.43.1",
    "typescript": "~6.0.3"
  }
}
