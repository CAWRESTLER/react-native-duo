{
  "expo": {
    "name": "React Native Duo Lab",
    "slug": "react-native-duo-example",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "react-native-duo-example",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.cawrestler.reactnativeduo.example"
    },
    "android": {
      "package": "dev.cawrestler.reactnativeduo.example"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "@cawrestler/react-native-duo",
        {
          "cameraPermission": "Allow Duo Lab to test the inner and outer cameras."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow React Native Duo Lab to test camera capture and compare available camera APIs.",
          "microphonePermission": "Allow React Native Duo Lab to use the microphone when recording camera tests.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5856D6"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "usePrecompiledModules": false
          }
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
