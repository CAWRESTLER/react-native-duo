{
  "name": "@cawrestler/react-native-duo",
  "version": "0.1.0",
  "description": "Native iPhone Duo layout, toolbar, scene, hinge, and camera APIs for React Native, with Android foldable support",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "cawrestler-react-native-duo-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./jest": {
      "cawrestler-react-native-duo-source": "./src/jest.tsx",
      "types": "./lib/typescript/src/jest.d.ts",
      "default": "./lib/module/jest.js"
    },
    "./package.json": "./package.json",
    "./app.plugin": "./app.plugin.js",
    "./app.plugin.js": "./app.plugin.js"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "app.plugin.js",
    "CHANGELOG.md",
    "RELEASE_NOTES.md",
    "docs",
    "!docs/assets",
    "scripts/install-git-hooks.js",
    "!ios/build",
    "!android/build",
    "!android/src/test",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @cawrestler/react-native-duo-example",
    "example:ios:clean": "yarn workspace @cawrestler/react-native-duo-example expo prebuild --clean && yarn workspace @cawrestler/react-native-duo-example ios",
    "clean": "del-cli lib",
    "prepare": "node scripts/install-git-hooks.js && bob build",
    "hooks:install": "node scripts/install-git-hooks.js",
    "test:tooling": "node --test scripts/__tests__/*.test.js",
    "check:compatibility": "node scripts/check-compatibility.js",
    "validate": "yarn check:compatibility && yarn lint && yarn typecheck && yarn example typecheck && yarn test:tooling && yarn test --runInBand && yarn pack:check",
    "prepublishOnly": "yarn validate",
    "pack:check": "yarn prepare && node scripts/check-package.js",
    "typecheck": "tsc",
    "test": "jest",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run",
    "lint": "eslint \"**/*.{js,ts,tsx}\""
  },
  "keywords": [
    "react-native",
    "ios",
    "iphone-duo",
    "foldable",
    "android",
    "jetpack-windowmanager",
    "hinge",
    "uikit",
    "expo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CAWRESTLER/react-native-duo.git"
  },
  "author": "Jacob Reyes <mx9556@gmail.com> (https://github.com/CAWRESTLER)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CAWRESTLER/react-native-duo/issues"
  },
  "homepage": "https://github.com/CAWRESTLER/react-native-duo#readme",
  "expo": {
    "plugin": "./app.plugin.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@expo/config-plugins": "57.0.9",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.88.0-rc.1",
    "@react-native/eslint-config": "0.88.0-rc.1",
    "@react-native/jest-preset": "0.88.0-rc.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "hermes-eslint": "^0.37.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "react": "19.3.0",
    "react-native": "0.88.0-rc.1",
    "react-native-builder-bob": "^0.43.1",
    "react-test-renderer": "19.3.0",
    "release-it": "^21.0.1",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=57.0.0",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "ReactNativeDuoViewSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.cawrestler.reactnativeduo"
    },
    "ios": {
      "components": {
        "RNDuoEnvironmentView": {
          "className": "RNDuoEnvironmentView"
        },
        "RNDuoArrangementView": {
          "className": "RNDuoArrangementView"
        },
        "RNDuoToolbarView": {
          "className": "RNDuoToolbarView"
        },
        "RNDuoNavigationToolbarView": {
          "className": "RNDuoNavigationToolbarView"
        },
        "RNDuoSceneAccessoryView": {
          "className": "RNDuoSceneAccessoryView"
        },
        "RNDuoCameraView": {
          "className": "RNDuoCameraView"
        }
      }
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "cawrestler-react-native-duo-source"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/scripts/__tests__/"
    ]
  },
  "release-it": {
    "git": {
      "commit": false,
      "tag": false,
      "push": false,
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}",
      "requireBranch": [
        "codex/release-*",
        "release-*"
      ],
      "requireUpstream": false
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "infile": "CHANGELOG.md",
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "fabric-view",
    "languages": "kotlin-objc",
    "tools": [
      "jest",
      "release-it",
      "eslint"
    ],
    "version": "0.63.1"
  }
}
